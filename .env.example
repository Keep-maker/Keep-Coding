# AI provider (OpenAI-compatible). Replace sk-xxx with your real key.
CURSOR_FORK_API_KEY=sk-xxx
CURSOR_FORK_BASE_URL=https://api.deepseek.com/v1
CURSOR_FORK_MODEL=deepseek-flash

# Server
CURSOR_FORK_PORT=8787
CURSOR_FORK_HOST=127.0.0.1
CURSOR_FORK_WORKSPACE=
CURSOR_FORK_MAX_STEPS=40
CURSOR_FORK_COMMAND_TIMEOUT_MS=120000

# Access control. REQUIRED whenever the server is reachable from a network:
# the agent can run arbitrary shell commands. Generate one with
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CURSOR_FORK_AUTH_TOKEN=
# Comma separated origins allowed to call the API when the UI is hosted
# elsewhere, e.g. https://keep-coding.pages.dev
CURSOR_FORK_ALLOWED_ORIGINS=
